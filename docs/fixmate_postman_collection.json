{
  "info": {
    "name": "FixMate API & Endpoint Collection",
    "_postman_id": "fixmate-v1-collection-2026",
    "description": "Comprehensive Postman collection for FixMate Home Service Management System. Covers Health, Auth, Customer, Provider, Admin, and Simulated Payments endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Public API Endpoints",
      "item": [
        {
          "name": "1. System Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/health",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "health"]
            },
            "description": "Returns operational status, MySQL connectivity status, and environment mode."
          }
        },
        {
          "name": "2. List Active Service Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/categories",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categories"]
            },
            "description": "Returns JSON catalog of all active service categories with base price limits."
          }
        },
        {
          "name": "3. Search Approved Providers by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/providers?category_id=1&pincode=400071",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "providers"],
              "query": [
                { "key": "category_id", "value": "1" },
                { "key": "pincode", "value": "400071" }
              ]
            },
            "description": "Searches verified providers offering the category, sorted by rating or distance."
          }
        },
        {
          "name": "4. Check Provider Live Availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/providers/1/availability",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "providers", "1", "availability"]
            },
            "description": "Queries provider's current status (AVAILABLE, BUSY, OFFLINE) and booked slots."
          }
        }
      ]
    },
    {
      "name": "Authentication (SRS 4.1)",
      "item": [
        {
          "name": "1. Customer Registration",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "name", "value": "Ananya Sharma" },
                { "key": "email", "value": "ananya@example.com" },
                { "key": "phone", "value": "9820011223" },
                { "key": "role", "value": "customer" },
                { "key": "password", "value": "Customer@123" },
                { "key": "confirm_password", "value": "Customer@123" },
                { "key": "terms_accepted", "value": "y" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "2. User Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "email", "value": "rahul@fixmate.local" },
                { "key": "password", "value": "Customer@123" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "3. User Logout",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Customer Booking & Lifecycle (SRS 4.4)",
      "item": [
        {
          "name": "1. Create Booking Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "provider_id", "value": "2" },
                { "key": "category_id", "value": "1" },
                { "key": "scheduled_date", "value": "2026-10-30" },
                { "key": "scheduled_time_slot", "value": "11:00 - 01:00 PM" },
                { "key": "service_address", "value": "Flat 302, Green View Apts, Chembur East, Mumbai" },
                { "key": "pincode", "value": "400071" },
                { "key": "special_instructions", "value": "Kitchen sink pipe is leaking heavily under the counter." }
              ]
            },
            "url": {
              "raw": "{{base_url}}/customer/book",
              "host": ["{{base_url}}"],
              "path": ["customer", "book"]
            }
          }
        },
        {
          "name": "2. Cancel Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "cancellation_reason", "value": "Found alternative local assistance." }
              ]
            },
            "url": {
              "raw": "{{base_url}}/customer/bookings/1/cancel",
              "host": ["{{base_url}}"],
              "path": ["customer", "bookings", "1", "cancel"]
            }
          }
        },
        {
          "name": "3. Submit Post-Completion Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "rating", "value": "5" },
                { "key": "comment", "value": "Outstanding plumbing repair. Arrived right on time and fixed the leak cleanly!" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/customer/bookings/1/review",
              "host": ["{{base_url}}"],
              "path": ["customer", "bookings", "1", "review"]
            }
          }
        },
        {
          "name": "4. Lodge Dispute Complaint",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "subject", "value": "Leak restarted after technician departed" },
                { "key": "description", "value": "The pipe joint gave way again 2 hours after completion. Requesting technician revisit or refund." }
              ]
            },
            "url": {
              "raw": "{{base_url}}/customer/bookings/1/complaint",
              "host": ["{{base_url}}"],
              "path": ["customer", "bookings", "1", "complaint"]
            }
          }
        }
      ]
    },
