# FixMate Environment Configuration Template
# Copy this file to .env and adjust credentials as appropriate for your local MySQL instance.

FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-to-a-very-secret-random-key-in-production

# MySQL Database Configuration
# Dedicated local instance runs on port 3307 (or change to 3306 if using system MySQL)
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=fixmate_db
TEST_DB_NAME=fixmate_test_db

DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3307/fixmate_db?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3307/fixmate_test_db?charset=utf8mb4

# Storage Paths
UPLOAD_FOLDER=var/uploads
MAX_CONTENT_LENGTH=5242880

# Business Rules Defaults
COMMISSION_PERCENTAGE=10.0
CANCELLATION_FEE_PERCENTAGE=10.0
CANCELLATION_WINDOW_MINUTES=15
GST_PERCENTAGE=18.0

# Security and Demo Settings
DEMO_MODE=True
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False

# Optional Email / Notification Settings (If empty, reset links display in console/banner)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@fixmate.local

# Default First Super Admin (Used by `flask create-admin` CLI if not supplied interactively)
FIRST_ADMIN_NAME=FixMate Admin
FIRST_ADMIN_EMAIL=admin@fixmate.local
FIRST_ADMIN_PASSWORD=Admin@FixMate2026!
FIRST_ADMIN_PHONE=9876543210
